includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- vendor/phpstan/phpstan-phpunit/extension.neon
	- vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
	level: 8

	paths:
		- src
		- tests
		- coupon-audit-and-analytics-for-woocommerce.php
		- uninstall.php

	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php

	# The WordPress core test suite: WP_UnitTestCase, tests_add_filter and the
	# rest. Scanned rather than analysed — it is somebody else's code, and the
	# copy the suite actually runs against is the one bin/install-wp-tests.sh
	# puts in place.
	scanDirectories:
		- vendor/wp-phpunit/wp-phpunit/includes

	# The distribution build is a copy of the plugin. Marked optional with (?)
	# because a fresh checkout has not built one, and PHPStan treats a missing
	# exclusion as a configuration error.
	excludePaths:
		- build (?)

	treatPhpDocTypesAsCertain: false
