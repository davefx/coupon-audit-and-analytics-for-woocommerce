# Everything that is part of building the plugin but not part of the plugin.
#
# wp.org's Plugin Check flags development tooling and hidden files in a
# distributed plugin, and it is right to: a shop does not need this repository's
# test harness, and shipping it enlarges the attack surface for no benefit.

/.git
/.github
/.gitignore
/.editorconfig
/.distignore

/tests
/bin
/docs
/.wordpress-org
/node_modules

/phpunit.xml.dist
/phpunit-integration.xml.dist
/phpcs.xml.dist
/phpstan.neon.dist
/composer.lock

# composer.json ships: Plugin Check expects one alongside a vendor directory,
# and its absence beside bundled dependencies is a fair thing to query.

/AGENTS.md
/CLAUDE.md
/README.md

/.phpunit.cache
/.phpunit.result.cache
